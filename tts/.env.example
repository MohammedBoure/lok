# ==============================================================================
# Gemini Text-to-Speech API Configuration
# ==============================================================================

# Option 1: Single Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Comma-separated list of keys for automatic failover & load balancing
# GEMINI_API_KEYS=key_alpha,key_beta,key_gamma

# Option 3: Sequentially indexed keys
# GEMINI_API_KEY_1=your_first_gemini_key
# GEMINI_API_KEY_2=your_second_gemini_key
# GEMINI_API_KEY_3=your_third_gemini_key

# Optional Client Defaults
DEFAULT_SPEECH_MODEL=gemini-3.8-flash-tts
DEFAULT_VOICE_NAME=Puck
KEY_COOLDOWN_SECONDS=60
MAX_RETRIES=3
